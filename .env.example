# ==============================================================================
# PlayTheory Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ==============================================================================

# LLM Provider Configuration
# Supported providers: gemini | openai | anthropic
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL_PLAN=gemini-3.5-flash-lite
LLM_MODEL_BUILD=gemini-3.5-flash-lite

# Upstash Redis Configuration (Required for Phase 4 caching, rate-limiting & persistence)
# Fallback to in-memory store occurs automatically if these are omitted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Security & Cost Guard
JOB_TOKEN_SECRET=playtheory_hmac_secret_key_change_in_production_min_32_chars
# Daily spend budget in USD (set to 0 for unlimited / free-tier quota mode)
DAILY_BUDGET_USD=0
# Rate limit for user generations per hour per IP
RATE_LIMIT_GENERATIONS_PER_HOUR=20

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
